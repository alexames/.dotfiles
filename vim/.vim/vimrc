""""""""""""""""""""""""""""""""""""""""
" stylua — format-on-save for Lua.

if executable('stylua')
  function! s:FormatLua() abort
    let l:old = getline(1, '$')
    let l:new = systemlist('stylua --search-parent-directories --stdin-filepath ' . shellescape(expand('%')) . ' -', l:old)
    if v:shell_error
      echohl WarningMsg | echo 'stylua failed; buffer unchanged' | echohl None
      return
    endif
    if l:new ==# l:old
      return
    endif
    let l:view = winsaveview()
    call setline(1, l:new)
    silent call deletebufline('%', len(l:new) + 1, '$')
    call winrestview(l:view)
  endfunction
  command! FormatLua call s:FormatLua()
  augroup auto_format_lua
    autocmd!
    autocmd BufWritePre *.lua FormatLua
  augroup END
endif

""""""""""""""""""""""""""""""""""""""""
" SwitchSourceHeader — replaces a.vim. Toggles between .h/.hpp/.hh/.hxx and
" .cc/.cpp/.cxx/.c/.m/.mm in the same directory.

function! s:SwitchSourceHeader() abort
  let l:ext = expand('%:e')
  let l:base = expand('%:p:r')
  let l:header_exts = ['h', 'hpp', 'hxx', 'hh']
  let l:source_exts = ['cc', 'cpp', 'cxx', 'c', 'mm', 'm']
  let l:candidates = []
  if index(l:header_exts, l:ext) >= 0
    let l:candidates = l:source_exts
  elseif index(l:source_exts, l:ext) >= 0
    let l:candidates = l:header_exts
  endif
  for l:cand in l:candidates
    let l:path = l:base . '.' . l:cand
    if filereadable(l:path)
      execute 'edit ' . fnameescape(l:path)
      return
    endif
  endfor
  echohl WarningMsg | echo 'No alternate file found' | echohl None
endfunction
command! A call s:SwitchSourceHeader()

