""""""""""""""""""""""""""""""""""""""""
" 'yegappan/lsp' — scoped to Lua only. YCM handles C/C++/Python.

function! s:SetupYegappanLsp() abort
  if !exists('*LspAddServer') || !executable('lua-language-server')
    return
  endif
  call LspOptionsSet(#{
        \   autoComplete: v:true,
        \   showSignature: v:true,
        \   echoSignature: v:false,
        \   useQuickfixForLocations: v:false,
        \ })
  call LspAddServer([#{
        \   name: 'lua-language-server',
        \   filetype: 'lua',
        \   path: exepath('lua-language-server'),
        \   args: [],
        \ }])
endfunction
autocmd vimrc VimEnter * call s:SetupYegappanLsp()

