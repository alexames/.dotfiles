" Optional packages that ship with Vim. silent! so older Vims just skip them.
silent! packadd! editorconfig              " Honour .editorconfig files.
silent! packadd! hlyank                    " Briefly highlight yanked text.

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"                                Basic Options                                 "
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

set background=dark        " Use the dark colorscheme instead of the light one.
silent! colorscheme onedark
let g:airline_theme='onedark'

set title                  " Sets the titlebar of the terminal to be the name of the file.
set hidden                 " Hides buffers rather than closing them when opening a new buffer.
set wildmode=longest:full,full " Complete the common prefix first, then cycle matches.
if has('patch-8.2.4463')
  set wildoptions=pum,fuzzy  " Show command-line matches in a popup menu, matched fuzzily.
endif
set timeoutlen=500         " Wait half a second (not a full one) for the rest of a mapping.
set splitright splitbelow  " New windows open to the right of / below the current one.
set noshowmode
set cursorline             " Highlight the line the cursor is on.
set nowrap                 " Forces lines to not wrap.
set belloff=all            " Never ring the bell or flash the screen.
set whichwrap+=<,>,h,l     " Backspace config.
set scrolloff=2            " ensures the cursor never reaches the bottom of the window.
set smartindent            " Intelligently guess the indentation level of the next line.
" set relativenumber         " Shows relative line numbers, making linewise motions easier.
set number                 " Display the absolute line number for the current line.
set formatoptions-=t       " Don't wrap to new lines at 80 characters automatically.
set noswapfile             " Disable swap files. I save often enough that these just get in the way.

" Keep undo history across sessions. Neovim's undo files are a different format
" and it already has a default location for them, so only relocate Vim's.
if has('persistent_undo')
  if !has('nvim')
    let &undodir = g:VIM_CONFIG_ROOT . '/undo'
    if !isdirectory(&undodir)
      call mkdir(&undodir, 'p', 0700)
    endif
  endif
  set undofile
endif

if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case
  set grepformat=%f:%l:%c:%m
else
  set grepprg=grep\ -rnH\ $* " sets GNU grep to be the program to run when searching.
                             "   -r: recursive by default
                             "   -n: show line numbers
                             "   -H: show filenames
endif
if !has('nvim')
set ttymouse=sgr           " Allow mouse to work through tmux; sgr handles wide terminals.
endif
set mouse=a                " What the mouse pointer looks like in different modes.
set guioptions=rLte        " Remove menu bar when using a GUI (gvim).
set nolist                 " No visible whitespace by default (keybind activates it elsewhere)
set listchars=tab:\\>,
             \space:·,
             \trail:•,
             \extends:…,
             \precedes:…,
             \nbsp:.,
             \eol:$,
set colorcolumn=81         " Put a line at 80 characters.
                           " But java and Objective-C should be set to 101.
set fillchars=vert:┃,
             \fold:━,
             \diff:~,
autocmd vimrc Filetype java setlocal colorcolumn=101
autocmd vimrc Filetype objc,objcpp setlocal colorcolumn=101

" Searching options
set hlsearch               " Highlight search results.
set ignorecase             " Ignore the case when searching strings.
set smartcase              " Ignore the ignorecase option if search pattern contains uppcase letters.

" Tab settings
set expandtab              " Tab key creates spaces instead of tabs.
set tabstop=2              " Tabs are 2 spaces.
set shiftwidth=2           " Tab characters are 2 spaces.
set softtabstop=2          " Soft tabs are 2 spaces.

" Fold settings
set foldenable
set foldmethod=indent
set foldlevelstart=99
autocmd vimrc FileType c,cpp setlocal foldmethod=syntax

set updatetime=100
set signcolumn=number

" When vimrc is edited, reload it. ++nested lets the colorscheme and airline
" autocmds fire during the reload.
autocmd vimrc BufWritePost
      \ $HOME/.vimrc,
      \$HOME/_vimrc,
      \$HOME/.vim/vimrc,
      \$HOME/.dotfiles/vim/_vimrc,
      \$HOME/.dotfiles/vim/.vim/vimrc,
      \$HOME/.dotfiles/vim/.vim/keybinds.vim
      \ ++nested source $MYVIMRC

" Files that can not be written should not be modifiable. Only applies to
" normal file buffers; plugin buffers (quickfix, NERDTree, ...) manage their
" own 'modifiable'.
autocmd vimrc BufReadPost,BufEnter,FileChangedRO * if &buftype ==# '' | let &l:modifiable = !&readonly | endif

" Disable autocomplete scratch preview window
set completeopt-=preview

" Auto reload files that have changed, provided there are no unsaved changes.
set autoread
" Trigger checktime when switching buffers or gaining focus
autocmd vimrc FocusGained,BufEnter,CursorHold,CursorHoldI * if mode() != 'c' | checktime | endif
" Notification when a file is reloaded
autocmd vimrc FileChangedShellPost * echohl WarningMsg | echo "File changed on disk. Buffer reloaded." | echohl None


""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"                                  Clipboard                                   "
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" Under WSL a terminal Vim has no X11/Wayland clipboard, so the "+ and "*
" registers don't exist. Provide them by talking to the Windows clipboard.
if has('clipboard_provider') && !has('clipboard')
      \ && executable('clip.exe') && executable('powershell.exe')
  function! s:WslClipCopy(reg, type, lines) abort
    let l:text = join(a:lines, "\n") . (a:type ==# 'V' ? "\n" : '')
    " clip.exe only handles non-ASCII text correctly as UTF-16.
    silent call system('iconv -f UTF-8 -t UTF-16LE | clip.exe', l:text)
  endfunction

  function! s:WslClipPaste(reg) abort
    silent let l:text = system('powershell.exe -NoProfile -Command "[Console]::OutputEncoding = [Text.Encoding]::UTF8; [Console]::Out.Write((Get-Clipboard -Raw))"')
    let l:lines = split(substitute(l:text, "\r", '', 'g'), "\n", 1)
    if len(l:lines) > 1 && l:lines[-1] ==# ''
      return ['V', l:lines[:-2]]
    endif
    return ['v', l:lines]
  endfunction

  let v:clipproviders['wsl'] = {
        \   'copy':  { '+': function('s:WslClipCopy'),  '*': function('s:WslClipCopy') },
        \   'paste': { '+': function('s:WslClipPaste'), '*': function('s:WslClipPaste') },
        \ }
  set clipmethod^=wsl
endif

