" This is the vimrc file for use across all computers I use.
" Changes specific to a specific computer should go in $HOME/.vimrc.

set nocompatible

" All autocmds defined in this file go in this group, so that re-sourcing the
" vimrc replaces them instead of stacking duplicates.
augroup vimrc
  autocmd!
augroup END

if has('win32')
  set shell=powershell\ -nologo
  let g:VIM_CONFIG_ROOT = $HOME . '/vimfiles'
else
  let g:VIM_CONFIG_ROOT = $HOME . '/.vim'
endif

execute 'source ' . g:VIM_CONFIG_ROOT . '/vim-plug-bootstrap.vim'

" Must be set before polyglot loads. vim-sleuth already detects indentation and
" vim-sensible is installed directly, so turn off polyglot's bundled copies.
let g:polyglot_disabled = ['autoindent', 'sensible']

